# JOGO DA COBRINHA

import pygame #INSTALAR A BIBLIOTECA "PYGAME"(pip install pygame)
import random

pygame.init()
tela = pygame.display.set_mode((700, 500))
pygame.display.set_caption("Jogo da Cobrinha")
 
pontos = 0
fonte_placar = pygame.font.Font(None, 30) 

cobra = [(100, 50)]
direcao = (10, 0)
comida = (300, 200)

def desenhar():
    tela.fill((0, 0 ,0))
    for parte in cobra:
        pygame.draw.rect(tela, (0, 255, 0), (*parte, 10 ,10))

    pygame.draw.rect(tela, (255, 0, 0), (*comida, 10, 10))
    
    texto_placar = fonte_placar.render(f"{pontos}", True, (255, 255, 255))
    tela.blit(texto_placar, (5, 5)) 

    pygame.display.update()

rodando = True
relogio = pygame.time.Clock()

while rodando:
    for evento in pygame.event.get():
        if evento.type == pygame.QUIT:
            rodando = False
            
        if evento.type == pygame.KEYDOWN:
            if evento.key == pygame.K_UP and direcao != (0, 10):
                direcao = (0, -10) 
            elif evento.key == pygame.K_DOWN and direcao != (0, -10):
                direcao = (0, 10)
            elif evento.key == pygame.K_LEFT and direcao != (10, 0):
                direcao = (-10, 0)
            elif evento.key == pygame.K_RIGHT and direcao != (-10, 0):
                direcao = (10, 0)

    nova_cabeca = (cobra[0][0] + direcao[0], cobra[0][1] + direcao[1])

    comeu = False
    if nova_cabeca == comida:
        pontos += 1
        comeu = True
        comida = (random.randrange(0, 600, 10), random.randrange(0, 400, 10))

    cobra.insert(0, nova_cabeca)

    if not comeu:
        cobra.pop()
    
    if nova_cabeca in cobra[1:] or \
nova_cabeca[0] < 0 or nova_cabeca[0] >= 700 or \
       nova_cabeca[1] < 0 or nova_cabeca[1] >= 500:
        rodando = False

    desenhar()
    relogio.tick(12)

pygame.quit()
